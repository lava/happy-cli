# Build stage
FROM node:20-alpine AS builder

# Install build dependencies
RUN apk add --no-cache python3 make g++ git tar

WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Copy tools and scripts for unpacking
COPY tools ./tools
COPY scripts ./scripts


# Copy source code
COPY . .

# Install all dependencies (including devDependencies for build)
RUN yarn install --frozen-lockfile

# Unpack platform-specific tools (ripgrep, difftastic, etc.)
RUN node ./scripts/unpack-tools.cjs

# Build the project
RUN yarn build

# Runtime stage
FROM node:20-alpine

# Install runtime dependencies including Python and Docker for happy-sandbox
RUN apk add --no-cache git ca-certificates python3 py3-pip docker-cli

# Create a non-root user
RUN addgroup -g 1001 -S happy && \
    adduser -S happy -u 1001 -G happy

WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Copy scripts needed for postinstall
COPY --from=builder /app/scripts ./scripts

# Copy unpacked tools from builder
COPY --from=builder /app/tools/unpacked ./tools/unpacked

# Install only production dependencies
RUN yarn install --frozen-lockfile --production && \
    yarn cache clean

# Copy built files from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/bin ./bin

# Install happy-sandbox directly from GitHub (as root before switching to non-root user)
RUN pip3 install --break-system-packages git+https://github.com/lava/happy-sandbox.git

# Copy entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Create necessary directories with correct permissions
RUN mkdir -p /home/happy/.happy/logs && \
    chown -R happy:happy /home/happy/.happy && \
    chown -R happy:happy /app

# Switch to non-root user
USER happy

# Set environment variables
ENV NODE_ENV=production
ENV HAPPY_HOME_DIR=/home/happy/.happy

# Expose the default port (if daemon uses a port)
EXPOSE 3000

# Health check for daemon status
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node ./bin/happy.mjs daemon status || exit 1

# Use entrypoint script to ensure setup before daemon start
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "./bin/happy.mjs", "daemon", "start-sync"]
